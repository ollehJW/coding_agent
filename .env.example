# FastAPI (python -m backend)
HOST=127.0.0.1
PORT=6174
# Relative paths are resolved from the project root.
DB_PATH=backend/app.db
COOKIE_SECURE=false

# Azure OpenAI: OPENAI_MODEL is the Azure deployment name.
OPENAI_MODEL=your-azure-deployment-name
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-resource.openai.azure.com
OPENAI_API_VERSION=2025-04-01-preview
OPENAI_TIMEOUT_SECONDS=60
OPENAI_CONNECT_TIMEOUT_SECONDS=10
# 1 retry = at most 2 API attempts. SDK retries are disabled.
OPENAI_MAX_RETRIES=1
# 설문 질문 생성 추론 강도: none(가장 빠름) | low(기본) | medium
OPENAI_SURVEY_REASONING_EFFORT=low
# 초기 프롬프트 작성 추론 강도: none | low(기본) | medium
OPENAI_PROMPT_REASONING_EFFORT=low
